# ============================================================
# P2P Payment Ledger — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/p2p_payment
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password

# --- JWT ---
# Must be at least 32 characters, random, kept secret.
JWT_SECRET=replace-with-a-secure-random-string-of-at-least-32-characters
JWT_EXPIRATION_MS=86400000

# --- Admin Bootstrap ---
# Used ONLY on first startup when no ADMIN user exists.
# After the admin is created, changing these values has no effect
# (existing admin is not updated). To reset the admin, delete the
# user row from the database and restart.
ADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password-min-8-chars
