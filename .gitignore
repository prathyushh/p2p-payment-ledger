# ===== Backend (Java/Maven/Spring Boot) =====
backend/target/
backend/*.class
backend/*.jar
backend/*.war

# Maven wrapper cache
backend/.mvn/repository/

# Spring Boot application secrets
backend/src/main/resources/application-local.yml
backend/src/main/resources/application-local.properties
backend/src/main/resources/application-prod.yml

# ===== Frontend (Node.js/React/Vite) =====
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/build/

# ===== Environment & Secrets =====
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.secret
secrets/

# ===== IDE & Editor =====
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
Thumbs.db

# ===== Logs =====
*.log
logs/
backend/logs/

# ===== Temporary files =====
*.tmp
*.temp
tmp/
temp/

# ===== OS =====
.DS_Store
Desktop.ini

# ===== Test outputs (keep sources, not generated reports) =====
backend/target/surefire-reports/

# ===== Coverage reports =====
backend/target/site/

# ===== Preserve these (do NOT ignore) =====
# docs/              - project documentation (tracked)
# .kiro/steering/    - Kiro steering files (tracked)
# backend/src/       - source code (tracked)
# frontend/src/      - source code (tracked)
# backend/src/main/resources/db/migration/ - Flyway migrations (tracked)
# backend/src/main/resources/application.yml - base config (tracked, no secrets)
